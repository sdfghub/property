# Local Postgres from docker-compose.yml is published on host port 5540 (5432 is taken by
# another local project).
DATABASE_URL="postgresql://postgres:postgres@localhost:5540/property_expenses?schema=public"
PORT=3100
NODE_ENV=development
# Allowed browser origins (Vite web on :5173, Expo on :8081).
APP_ORIGIN=http://localhost:5173,http://localhost:8081

# ── Optional locally, REQUIRED in prod ────────────────────────────────────────────────
# Token signing. Unset falls back to dev_access_secret / dev_refresh_secret, which is fine
# locally and unacceptable in prod. Generate with: openssl rand -hex 32
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=900s
# JWT_REFRESH_TTL=30d

# Base URL used in invite / notification links.
# APP_PUBLIC_URL=http://localhost:5173

# Outbound email. Without these, invite emails silently do NOT send — take the invite link
# from the API response instead. See docs/local-dev.md.
# MAIL_FROM="Property <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Seed admin (npm run seed) — defaults to bogdan.boji@gmail.com / 123456 locally.
# ROOT_EMAIL=
# ROOT_PASSWORD=

# Push notifications (optional): a Firebase service account, inline JSON or a path.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=
